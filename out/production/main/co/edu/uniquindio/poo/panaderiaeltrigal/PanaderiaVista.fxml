<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="760.0" prefWidth="940.0" style="-fx-background-color: #FAF6F0;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.panaderiaeltrigal.viewController.PanaderiaViewController">

    <!-- ENCABEZADO -->
    <top>
        <VBox spacing="2.0" style="-fx-background-color: #5C3A21;">
            <padding>
                <Insets bottom="12.0" left="18.0" right="18.0" top="12.0" />
            </padding>
            <children>
                <Label text="Panadería El Trigal" textFill="#FFFDF8">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Registro de pedidos y asignación a producción" textFill="#E3D3C0" />
            </children>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <!-- PESTANA 1: EMPLEADOS -->
                <Tab text="Empleados">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <Label text="Datos del empleado" textFill="#5C3A21">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label text="Seleccione una fila de la tabla para actualizar o eliminar." textFill="#8A7968" />
                                <GridPane hgap="10.0" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="140.0" />
                                        <ColumnConstraints minWidth="220.0" />
                                        <ColumnConstraints minWidth="140.0" />
                                        <ColumnConstraints minWidth="220.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Tipo de empleado:" textFill="#6B5A4A" />
                                        <ComboBox fx:id="cbTipoEmpleado" prefWidth="220.0" promptText="Seleccione" GridPane.columnIndex="1" />
                                        <Label text="Código:" textFill="#6B5A4A" GridPane.columnIndex="2" />
                                        <TextField fx:id="txtCodigo" promptText="Ej. E05" GridPane.columnIndex="3" />
                                        <Label text="Nombre:" textFill="#6B5A4A" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <Label text="Documento:" textFill="#6B5A4A" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtDocumento" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                        <Label text="Minutos disponibles:" textFill="#6B5A4A" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtMinutos" promptText="Al comienzo del turno" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <Label text="Caja (solo cajeros):" textFill="#6B5A4A" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtCaja" promptText="Ej. Caja 2" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#onAgregarEmpleado" style="-fx-background-color: #8A5A33; -fx-background-radius: 6; -fx-text-fill: white;" text="Registrar" />
                                        <Button mnemonicParsing="false" onAction="#onActualizarEmpleado" style="-fx-background-color: #8A5A33; -fx-background-radius: 6; -fx-text-fill: white;" text="Actualizar" />
                                        <Button mnemonicParsing="false" onAction="#onEliminarEmpleado" style="-fx-background-color: #9E4A3C; -fx-background-radius: 6; -fx-text-fill: white;" text="Eliminar" />
                                        <Button mnemonicParsing="false" onAction="#onLimpiarEmpleado" style="-fx-background-color: #EDE3D6; -fx-background-radius: 6; -fx-text-fill: #5C3A21;" text="Limpiar campos" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tblEmpleados" onMouseClicked="#onSeleccionarEmpleado" style="-fx-border-color: #E3D8CB;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
                                        <TableColumn fx:id="colTipo" prefWidth="160.0" text="Tipo" />
                                        <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                                        <TableColumn fx:id="colDocumento" prefWidth="150.0" text="Documento" />
                                        <TableColumn fx:id="colMinutos" prefWidth="160.0" text="Minutos disponibles" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- PESTANA 2: PEDIDOS Y PRODUCCION -->
                <Tab text="Pedidos y producción">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <Label text="Datos del pedido" textFill="#5C3A21">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label text="Seleccione una fila para actualizar, asignar o cancelar." textFill="#8A7968" />
                                <GridPane hgap="10.0" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="140.0" />
                                        <ColumnConstraints minWidth="220.0" />
                                        <ColumnConstraints minWidth="140.0" />
                                        <ColumnConstraints minWidth="220.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Código:" textFill="#6B5A4A" />
                                        <TextField fx:id="txtCodigoPedido" promptText="Ej. P04" GridPane.columnIndex="1" />
                                        <Label text="Cliente:" textFill="#6B5A4A" GridPane.columnIndex="2" />
                                        <TextField fx:id="txtCliente" GridPane.columnIndex="3" />
                                        <Label text="Tipo de pan:" textFill="#6B5A4A" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cbTipoPan" prefWidth="220.0" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <Label text="Cantidad de panes:" textFill="#6B5A4A" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtCantidad" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                    </children>
                                </GridPane>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#onRegistrarPedido" style="-fx-background-color: #8A5A33; -fx-background-radius: 6; -fx-text-fill: white;" text="Registrar pedido" />
                                        <Button mnemonicParsing="false" onAction="#onActualizarPedido" style="-fx-background-color: #8A5A33; -fx-background-radius: 6; -fx-text-fill: white;" text="Actualizar pedido pendiente" />
                                        <Button mnemonicParsing="false" onAction="#onVerPedido" style="-fx-background-color: #EDE3D6; -fx-background-radius: 6; -fx-text-fill: #5C3A21;" text="Ver pedido" />
                                        <Button mnemonicParsing="false" onAction="#onLimpiarPedido" style="-fx-background-color: #EDE3D6; -fx-background-radius: 6; -fx-text-fill: #5C3A21;" text="Limpiar campos" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tblPedidos" onMouseClicked="#onSeleccionarPedido" style="-fx-border-color: #E3D8CB;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colCodigoPedido" prefWidth="70.0" text="Código" />
                                        <TableColumn fx:id="colCliente" prefWidth="190.0" text="Cliente" />
                                        <TableColumn fx:id="colTipoPan" prefWidth="110.0" text="Tipo de pan" />
                                        <TableColumn fx:id="colCantidad" prefWidth="80.0" text="Cantidad" />
                                        <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                                        <TableColumn fx:id="colEmpleadoAsignado" prefWidth="120.0" text="Empleado" />
                                        <TableColumn fx:id="colMinutosReservados" prefWidth="150.0" text="Minutos reservados" />
                                    </columns>
                                </TableView>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#onEstimarTiempos" style="-fx-background-color: #EDE3D6; -fx-background-radius: 6; -fx-text-fill: #5C3A21;" text="Ver tiempos de cada panadero" />
                                        <Button mnemonicParsing="false" onAction="#onAsignarPedido" style="-fx-background-color: #5E7D4A; -fx-background-radius: 6; -fx-text-fill: white;" text="Asignar a producción" />
                                        <Button mnemonicParsing="false" onAction="#onCancelarPedido" style="-fx-background-color: #9E4A3C; -fx-background-radius: 6; -fx-text-fill: white;" text="Cancelar pedido" />
                                    </children>
                                </HBox>
                                <TextArea fx:id="txtResultado" editable="false" minHeight="100.0" prefHeight="110.0" promptText="Aquí se muestran los tiempos que tardaría cada panadero" style="-fx-control-inner-background: #FFFDF9;" wrapText="true" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
